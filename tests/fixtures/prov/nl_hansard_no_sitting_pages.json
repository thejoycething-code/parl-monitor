  "https://www.assembly.nl.ca/HouseBusiness/Hansard/ga48session3/18-03-29.htm": "﻿<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<meta content=\"en-us\" http-equiv=\"Content-Language\" />\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\" />\n<title>The House of Assembly stands adj</title>\n</head>\n\n<body>\n\n<p>\n<span style=\"color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">\nThe House of Assembly stands adjourned to the call of the Chair. As per the \nParliamentary Calendar, the next scheduled sitting day is Monday, April 16, \n2018.</span></p>\n\n</body>\n\n</html>\n",
  "https://www.assembly.nl.ca/HouseBusiness/Hansard/ga48session3/19-04-03.htm": "﻿<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<meta content=\"en-us\" http-equiv=\"Content-Language\" />\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\" />\n<title>The Third Session of the 48th Ge</title>\n</head>\n\n<body>\n\n<p>The Third Session of the 48th General Assembly prorogued on April 2nd, 2019.</p>\n\n</body>\n\n</html>\n",
  "https://www.assembly.nl.ca/HouseBusiness/Hansard/ga48session4/19-04-18.htm": "﻿<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<meta content=\"en-us\" http-equiv=\"Content-Language\" />\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\" />\n<title>The 48th General Assembly was di</title>\n</head>\n\n<body>\n\n<p>The 48th General Assembly was dissolved on April 17, 2019. A General Election \nwas scheduled for May 16, 2019.</p>\n\n</body>\n\n</html>\n",
  "https://www.assembly.nl.ca/HouseBusiness/Hansard/ga49session1/20-03-02.htm": "﻿<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<meta content=\"en-us\" http-equiv=\"Content-Language\" />\n<meta content=\"text/html; charset=utf-8\" http-equiv=\"Content-Type\" />\n<title>The House of Assembly did not si</title>\n</head>\n\n<body>\n\n<p>The House of Assembly did not sit on Monday, March 2, 2020, due to inclement \nweather. The House reconvened at 1:30 p.m. on Tuesday, March 3, 2020.</p>\n\n</body>\n\n</html>\n",
