<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- UK session judge on the Mac Mini (jobs/uk-session-judge.sh): Sundays 12:30 London,
     between the Sunday pull (02:00, about 40 minutes) and the Monday publish (04:00), after Bolivia's
     11:00 weekly and before Honduras at 14:00 and the editions session judge at 16:45 (if one overruns,
     this queues behind it on the runner lock). Claude Code scores at most 200 items a week (the Sunday
     pull's items, then the devolved rows, then the 5CA stances), 25 to a session, on the work
     subscription's plan allowance, not the API (round 3, 16 October 2026: paid AI off for the UK weekly).
     Mac Mini only: no GitHub workflow and no mini-check gate. Time limit two hours.
     Needs Claude Code installed and signed in to the work account (claude auth login).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.uk-session-judge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.uk-session-judge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>uk-session-judge</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>7200</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/uk-session-judge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/uk-session-judge.log</string>
</dict>
</plist>
