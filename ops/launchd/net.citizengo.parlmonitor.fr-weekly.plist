<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- France weekly on the Mac Mini: Saturdays at 04:30 London, after the
     Assemblee's Tuesday-Thursday (and some Friday) sittings and after its
     nightly open-data refresh (the zips were stamped 22:27-02:06 UTC on
     8-9 October 2026). The GitHub crons (04:30 and 06:30 UTC on Saturdays,
     .github/workflows/fr-weekly.yml) are the backup and skip themselves when
     this has run (the gate allows 200 minutes, because 04:30 London is
     03:30 UTC in summer).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.fr-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.fr-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>fr-weekly</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/fr-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/fr-weekly.log</string>
</dict>
</plist>
