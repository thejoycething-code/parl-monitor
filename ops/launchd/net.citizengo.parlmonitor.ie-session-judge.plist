<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ireland session judge on the Mac Mini (jobs/ie-session-judge.sh): Fridays 18:30 London,
     after the Ireland weekly (09:30) and the US weekly (10:00) that queues behind it, after Friday's
     18:00 Division watch (it queues behind it if that is still going) and before the US session judge
     (19:30). Claude Code scores at most 100 pending items, 25 to a session, on the work subscription's plan allowance, not the API.
     Mac Mini only: no GitHub workflow and no mini-check gate. Time limit 90 minutes.
     Needs Claude Code installed and signed in to the work account (claude auth login).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.ie-session-judge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.ie-session-judge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>ie-session-judge</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>5400</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/ie-session-judge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/ie-session-judge.log</string>
</dict>
</plist>
