<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Peru weekly on the Mac Mini: Saturdays at 16:00 London, after the Tuesday
     to Thursday plenaries in Lima and the Friday uploads of their vote
     records. The GitHub crons (17:00 and 20:00 UTC on Saturdays,
     .github/workflows/pe-weekly.yml) are the backup and skip themselves
     when this has run (the gate allows 330 minutes, because 16:00 London
     is 15:00 UTC in summer, five hours before the 20:00 retry).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.pe-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.pe-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>pe-weekly</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/pe-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/pe-weekly.log</string>
</dict>
</plist>
