<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Guatemala weekly on the Mac Mini: Saturdays at 09:00 London, after the
     Congreso's Tuesday-Thursday plenary week. The GitHub crons (09:00 and
     12:00 UTC on Saturdays, .github/workflows/gt-weekly.yml) are the backup
     and skip themselves when this has run (the gate allows 260 minutes,
     because 09:00 London is 08:00 UTC in summer, four hours before the
     retry slot).
     BEFORE INSTALLING: check the Mini is not refused by www.congreso.gob.gt
     (the scoping laptop was; GitHub's runners were not). From the Mini:
       curl -s -o /dev/null -w "%{http_code}\n" -A "CitizenGO-ParlMonitor/1.0 (contact: cjoyce@citizengo.net)" https://www.congreso.gob.gt/
     200 means install; 403 means leave this uninstalled and let GitHub run it.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.gt-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.gt-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>gt-weekly</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/gt-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/gt-weekly.log</string>
</dict>
</plist>
