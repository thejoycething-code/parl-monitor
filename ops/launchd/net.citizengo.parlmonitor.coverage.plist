<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Coverage watch on the Mac Mini (docs/mac-mini-runner.md), daily at 05:30
     London. launchd uses local time, so this stays 05:30 London all year;
     the GitHub backup's cron is 05:30 UTC (06:30 London in summer). Either
     way it lands before the Monday publish window.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.coverage.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.coverage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>coverage</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/coverage.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/coverage.log</string>
</dict>
</plist>
