<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Latam monthly on the Mac Mini: the 1st of each month at 13:15 London.
     Venezuela's news check, Nicaragua's La Gaceta check, their alerts, then
     the Latam edition and its DM to Chris (jobs/latam-monthly.sh). The
     GitHub crons (12:15 and 15:15 UTC on the 1st,
     .github/workflows/latam-monthly.yml) are the backup and skip themselves
     when this has run (the gate allows 200 minutes, because 13:15 London is
     12:15 UTC in summer, three hours before the 15:15 retry). No other job
     on main starts at :15, so the slot never queues behind a weekly.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.latam-monthly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.latam-monthly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>latam-monthly</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/latam-monthly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/latam-monthly.log</string>
</dict>
</plist>
