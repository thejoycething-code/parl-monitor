<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Devolved watch on the Mac Mini (tools/devolved_brief.py): 20:30 London
     Mon-Thu, after Holyrood's Decision Time results are published (measured
     17:08-19:00 on the same evening for 17 of 27 sitting days), after the
     Senedd's Tuesday and Wednesday voting time and the Assembly's Monday and
     Tuesday divisions; and 12:45 Tue-Fri for what the sources publish the
     next morning (Holyrood: 09:10-12:22 on 7 of 27 days). Clear of the
     Westminster division watch's runner slots (19:00 and 22:00 Mon-Thu,
     14:00, 16:00 and 18:00 Fri): a run takes a minute or two.
     The GitHub crons (19:30 and 11:45 UTC) were set in BST for these London
     hours, less Wednesday midday (the Provinces weekly's window on GitHub);
     launchd keeps London time, so the Mini holds them all year.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.devolved-watch.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.devolved-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>devolved-watch</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/devolved-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/devolved-watch.log</string>
</dict>
</plist>
