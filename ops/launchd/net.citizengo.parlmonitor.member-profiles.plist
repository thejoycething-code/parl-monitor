<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Member profiles on the Mac Mini (jobs/member-profiles.sh): the 10th of each month, 09:00 London, the hour the
     GitHub crons (08:00 on the 10th UTC) were set for in BST. Time limit 60 minutes.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.member-profiles.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.member-profiles</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>member-profiles</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>3600</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>10</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/member-profiles.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/member-profiles.log</string>
</dict>
</plist>
