<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Australia session judge on the Mac Mini (jobs/au-session-judge.sh): Fridays 03:10 London,
     after the Australia weekly (02:00, an hour at most; if it is still running this queues behind it
     on the runner lock) and before the 04:40 US division watch. Claude Code scores at most 100 pending
     items, 25 to a session, on the work subscription's plan allowance, not the API.
     Mac Mini only: no GitHub workflow and no mini-check gate. Time limit 90 minutes.
     Needs Claude Code installed and signed in to the work account (claude auth login).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.au-session-judge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.au-session-judge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>au-session-judge</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>5400</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/au-session-judge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/au-session-judge.log</string>
</dict>
</plist>
