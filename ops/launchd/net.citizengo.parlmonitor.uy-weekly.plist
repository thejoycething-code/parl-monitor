<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Uruguay weekly on the Mac Mini: Sundays at 08:00 London, after the
     Cámara de Representantes' Tuesday-Wednesday plenary week (its open-data
     files are regenerated every evening, about 18:30 UTC). The GitHub crons
     (08:00 and 11:00 UTC on Sundays, .github/workflows/uy-weekly.yml) are
     the backup and skip themselves when this has run (the gate allows 260
     minutes, because 08:00 London is 07:00 UTC in summer, four hours before
     the retry slot).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.uy-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.uy-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>uy-weekly</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/uy-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/uy-weekly.log</string>
</dict>
</plist>
