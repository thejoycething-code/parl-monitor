<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Brief narratives on the Mac Mini (jobs/brief-narratives.sh): Sundays 18:15 London,
     after the UK session judge (12:30) and the editions session judge (16:45, about 15 minutes),
     before the German weekly (20:00) and the Monday publish (04:00), which build the briefs.
     Claude Code drafts at most 6 Campaigns Brief narratives a week, one to a session, on the work
     subscription's plan allowance, not the API (16 October 2026: paid AI off for brief narratives).
     Mac Mini only: no GitHub workflow and no mini-check gate. Time limit 100 minutes.
     Needs Claude Code installed and signed in to the work account (claude auth login).
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.brief-narratives.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.brief-narratives</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>brief-narratives</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>6000</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/brief-narratives.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/brief-narratives.log</string>
</dict>
</plist>
