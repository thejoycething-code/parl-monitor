<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hungary weekly (phase 0, the Magyar Közlöny) on the Mac Mini: Wednesdays
     at 03:00 London, after the Országgyűlés's Monday and Tuesday sittings,
     and in a slot no other job holds (Saturday is full). The GitHub crons
     (03:00 and 05:00 UTC on Wednesdays, .github/workflows/hu-weekly.yml) are
     the backup and skip themselves when this has run (the gate allows 200
     minutes, because 03:00 London is 02:00 UTC in summer, three hours before
     the retry slot). JOB_TIMEOUT is 45 minutes: the collector stops itself at
     30, which only the first run (the term's backfill) can reach.
     Install: cp to ~/Library/LaunchAgents, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.citizengo.parlmonitor.hu-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.citizengo.parlmonitor.hu-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christopherjoyce/runner/parl-monitor/tools/mini_run.sh</string>
    <string>hu-weekly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JOB_TIMEOUT</key>
    <string>2700</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/christopherjoyce/runner/logs/hu-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christopherjoyce/runner/logs/hu-weekly.log</string>
</dict>
</plist>
