# Copy to config/secrets.yaml (gitignored) and fill in. Each credential
# enables one step of the unattended chain; missing ones are skipped and
# disclosed in the Monday log, never fatal.

# Live triage scoring (Sunday pull). platform.claude.com -> API keys.
anthropic_api_key: sk-ant-...

# Slack posting (Monday publish). Create an app at api.slack.com/apps with
# bot scopes chat:write, canvases:write; install to the workspace; invite
# the bot to the channel (/invite @ParlMonitor in #campaigns-en-gb).
slack_bot_token: xoxb-...
slack_channel_id: C9RH217PZ
slack_team_id: T066M0LAJ

# Asana reading task (Monday publish). Asana -> Settings -> Apps ->
# Developer apps -> Create personal access token.
asana_pat: 2/...
asana_workspace: "826488630492934"

# US monitor (docs/us-scope.md). On Actions these come from the repository
# secrets CONGRESS_API_KEY and OPENSTATES_API_KEY instead.
# api.data.gov/signup -> the key arrives by email. ONE key serves
# Congress.gov (bill amendments, committee meetings), GovInfo (the
# Congressional Record) and Regulations.gov.
congress_api_key: ""
# open.pluralpolicy.com -> create an account -> profile page -> API key.
# Bills, votes and sponsors for all fifty state legislatures.
openstates_api_key: ""
